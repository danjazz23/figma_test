<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema principal de Clover App -->
    <style name="Theme.CloverApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <!-- Estilo para textos tipo Ancla -->
    <style name="TextAnchorStyle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- Estilo para el botón de WhatsApp -->
    <style name="WhatsAppButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/clover_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>
